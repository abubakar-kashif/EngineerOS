# EngineerOS backend environment (server-side only — never commit real secrets)

# Application
DEBUG=true
DATABASE_URL=sqlite:///./engineeros.db

# AI Mentor — required for real Gemini replies in the browser.
# Place this file at backend/.env (loaded by absolute path from config.py).
# Never put AI_API_KEY in the frontend or commit a real key.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
# AI_API_KEY=          # paste server-side Gemini key here (never commit a real key)
# GEMINI_API_KEY=      # optional alias for AI_API_KEY
# AI_BASE_URL=
# AI_TIMEOUT_SECONDS=60
# AI_MAX_OUTPUT_TOKENS=1000
# AI_TEMPERATURE=0.7

# Email delivery:
#   console — development/debug only (writes the full message, including codes, to the server log)
#   smtp    — real mailbox delivery (codes go to the inbox only; never returned in API responses)
# Console is NOT a production delivery mechanism. Use EMAIL_DELIVERY=smtp so
# verification codes reach the user's email. Unknown values raise when DEBUG=false.
#
# Gmail (recommended for a real inbox test):
#   1. Enable 2-Step Verification on the Google account
#   2. Create a Google App Password (not the normal Gmail password)
#   3. Set EMAIL_DELIVERY=smtp and the SMTP_* values below
# Never commit real SMTP_PASSWORD values.
EMAIL_DELIVERY=console

# SMTP settings (required when EMAIL_DELIVERY=smtp)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
