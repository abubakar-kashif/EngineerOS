# EngineerOS backend environment (server-side only — never commit real secrets)

# Application
DEBUG=true
DATABASE_URL=sqlite:///./engineeros.db

# AI Mentor — required for real OpenAI replies in the browser.
# Place this file at backend/.env (loaded by absolute path from config.py).
# Never put AI_API_KEY in the frontend or commit a real key.
AI_PROVIDER=openai
AI_MODEL=gpt-3.5-turbo
# AI_API_KEY=sk-...
# AI_BASE_URL=
# AI_TIMEOUT_SECONDS=60
# AI_MAX_OUTPUT_TOKENS=1000
# AI_TEMPERATURE=0.7

# Email delivery: "console" (development) or "smtp" (configured environments)
EMAIL_DELIVERY=console

# SMTP settings (required when EMAIL_DELIVERY=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
