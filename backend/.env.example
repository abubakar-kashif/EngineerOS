# EngineerOS backend environment (server-side only — never commit real secrets)

# Application
DEBUG=true
DATABASE_URL=sqlite:///./engineeros.db

# AI Mentor — required for real Gemini replies in the browser.
# Place this file at backend/.env (loaded by absolute path from config.py).
# Never put AI_API_KEY in the frontend or commit a real key.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.6-flash
# AI_API_KEY=          # paste server-side Gemini key here (never commit a real key)
# GEMINI_API_KEY=      # optional alias for AI_API_KEY
# AI_BASE_URL=
# AI_TIMEOUT_SECONDS=60
# AI_MAX_OUTPUT_TOKENS=1000
# AI_TEMPERATURE=0.7

# Email delivery:
#   console — development only (writes the full message, including codes, to the server log)
#   smtp    — production (codes go to the mailbox only; never returned in API responses)
# When DEBUG=false, prefer EMAIL_DELIVERY=smtp. Unknown values raise instead of
# silently falling back to console.
EMAIL_DELIVERY=console

# SMTP settings (required when EMAIL_DELIVERY=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
