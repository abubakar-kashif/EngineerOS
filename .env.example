# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database
DATABASE_URL=sqlite:///./engineeros.db

# Frontend (public) — never put AI_API_KEY or Gemini secrets here
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# AI Configuration (server-side only — copy into backend/.env, not frontend)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
# AI_API_KEY=
# GEMINI_API_KEY=
# AI_TIMEOUT_SECONDS=60
# AI_MAX_OUTPUT_TOKENS=1000
# AI_TEMPERATURE=0.7
